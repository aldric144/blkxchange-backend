# BlkXchange Backend Environment Variables

# Database Configuration (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/blkxchange

# CORS Origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-url.com

# Stripe Configuration (for production)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email Configuration
# For MVP, email is logged to console
# To enable Ethereal Email, set USE_ETHEREAL=True in app/email.py
